# Copy to .env and fill in. Never commit .env.

# Required: bearer token clients must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
NAS_MCP_TOKEN=change-me

# Required: the Root (folder exposed to agents), as seen inside the container.
NAS_MCP_ROOT=/data

# Listen port inside the container (default 8080) and address (default 0.0.0.0).
NAS_MCP_PORT=8080
NAS_MCP_HOST=0.0.0.0

# Optional: extra Hidden Entry glob patterns, comma-separated.
# A pattern without "/" matches an entry name at any depth (e.g. "*.tmp", "private");
# a pattern with "/" matches a Root-relative Path (e.g. "family/taxes").
# Note: "*" does not match names starting with "." (use ".*" for dotfiles).
NAS_MCP_HIDDEN_PATTERNS=

# Optional: read size limits in bytes. Text (whole file, or one offset/limit part) and PDF
# default to 10 MB (10485760); images default to 20 MB (20971520).
NAS_MCP_READ_TEXT_MAX_BYTES=10485760
NAS_MCP_READ_IMAGE_MAX_BYTES=20971520
