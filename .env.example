# Copy to .env and fill in. Never commit .env.

# Required: bearer token clients must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32 (at least 16 characters; the server refuses
# to start while this is still the placeholder below).
NAS_MCP_TOKEN=<token-from-openssl-rand-hex-32>

# Required: the Root as seen inside the container: the folder whose sub-folders are the
# Mounts (each one a NAS shared folder, mounted in compose.yaml).
# compose.yaml fixes this to /data; set it only when running outside the container.
NAS_MCP_ROOT=/data

# Optional: every folder under NAS_MCP_ROOT must be its own mount point (default true),
# which catches the v1 single-folder layout and nested container paths in compose.yaml. Set false only when running outside
# the container with plain folders as Mounts (local development).
NAS_MCP_REQUIRE_MOUNT_POINTS=true

# Listen port inside the container (default 8080) and address (default 0.0.0.0).
# compose.yaml fixes these; set them only when running outside the container.
NAS_MCP_PORT=8080
NAS_MCP_HOST=0.0.0.0

# Optional: extra Hidden Entry glob patterns, comma-separated.
# A pattern without "/" matches an entry name at any depth (e.g. "*.tmp", "private");
# a pattern with "/" matches a Root-relative Path, which starts with the Mount
# (e.g. "documents/family/taxes").
# Note: "*" does not match names starting with "." (use ".*" for dotfiles).
NAS_MCP_HIDDEN_PATTERNS=

# Optional: read size limits in bytes. Text (whole file, or one offset/limit part) and PDF
# default to 10 MB (10485760); images default to 20 MB (20971520).
NAS_MCP_READ_TEXT_MAX_BYTES=10485760
NAS_MCP_READ_IMAGE_MAX_BYTES=20971520

# Optional: search limits. Max results per search call (default 100), and the
# largest file content search will grep, in bytes (default 5242880 = 5 MB).
NAS_MCP_SEARCH_MAX_RESULTS=100
NAS_MCP_GREP_MAX_FILE_BYTES=5242880

# Optional: Trash retention. Trashed entries older than this many days are permanently
# removed (default 30; 0 = keep forever). Purge runs at startup and then every
# NAS_MCP_TRASH_PURGE_INTERVAL_SECONDS (default 3600 = hourly).
NAS_MCP_TRASH_RETENTION_DAYS=30
NAS_MCP_TRASH_PURGE_INTERVAL_SECONDS=3600

# --- compose.yaml only (Container Manager Project) ---
# The Mounts themselves are volume lines in compose.yaml, not settings here.

# Required: UID and GID of the dedicated DSM user the container runs as (never 0/root).
# Find them over SSH with: id <dsm-user>
# The values below are EXAMPLES (kept as real-looking values so CI can validate compose.yaml);
# replace them with your own.
NAS_MCP_UID=1026
NAS_MCP_GID=100

# Host port on the NAS that maps to the container's port 8080 (default 8080).
NAS_MCP_HOST_PORT=8080
