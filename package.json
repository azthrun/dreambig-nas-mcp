{
  "name": "dreambig-nas-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing NAS shared folders (Mounts) to agents over Streamable HTTP",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "[ -d .git ] && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
